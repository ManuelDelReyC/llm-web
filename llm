#!/usr/bin/env bash
# Script unificado para gestionar el stack local de llm-web.
# Uso: ./llm {cli|api|web|stop|status|webui-reset}

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuración
# ---------------------------------------------------------------------------

LLAMA_PORT="${LLAMA_PORT:-8080}"
SEARXNG_PORT="${SEARXNG_PORT:-8081}"
API_PORT="${API_PORT:-8090}"
WEBUI_PORT="${WEBUI_PORT:-3000}"

LLAMA_URL="http://127.0.0.1:${LLAMA_PORT}"
SEARXNG_URL="http://127.0.0.1:${SEARXNG_PORT}"
API_URL="http://127.0.0.1:${API_PORT}"

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SEARXNG_DIR="${REPO_DIR}/searxng"
WEBUI_DIR="${REPO_DIR}/open-webui"
RUN_DIR="/tmp/opencode/llm-web"
LOG_DIR="${RUN_DIR}/logs"
PID_DIR="${RUN_DIR}/pids"

MODEL="${MODEL:-$HOME/Proyectos/llama/models/Qwen3-Coder-30B-A3B-Instruct.Q4_K_M.gguf}"
LLAMA_SERVER="${LLAMA_SERVER:-$HOME/Proyectos/llama/src/llama.cpp/build/bin/llama-server}"

NGL="${NGL:-auto}"
CTX="${CTX:-32768}"
BATCH="${BATCH:-256}"

mkdir -p "${LOG_DIR}" "${PID_DIR}"

# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

pid_file() {
    echo "${PID_DIR}/${1}.pid"
}

save_pid() {
    echo "$2" > "$(pid_file "$1")"
}

read_pid() {
    cat "$(pid_file "$1")" 2>/dev/null || true
}

remove_pid() {
    rm -f "$(pid_file "$1")"
}

is_port_open() {
    local port="$1"
    python3 -c "
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(1)
result = s.connect_ex(('127.0.0.1', ${port}))
s.close()
sys.exit(0 if result == 0 else 1)
" 2>/dev/null
}

wait_for_port() {
    local port="$1"
    local name="$2"
    local timeout="${3:-60}"

    log "Esperando a ${name} en puerto ${port}..."
    for ((i = 0; i < timeout; i++)); do
        if is_port_open "${port}"; then
            log "✅ ${name} listo en puerto ${port}"
            return 0
        fi
        sleep 1
    done

    log "❌ ${name} no respondió en ${timeout}s"
    return 1
}

# ---------------------------------------------------------------------------
# Inicio de servicios
# ---------------------------------------------------------------------------

start_llama() {
    if is_port_open "${LLAMA_PORT}"; then
        log "✅ llama-server ya está corriendo en ${LLAMA_URL}"
        return 0
    fi

    if [ ! -f "${MODEL}" ]; then
        log "❌ Modelo no encontrado: ${MODEL}"
        exit 1
    fi

    if [ ! -x "${LLAMA_SERVER}" ]; then
        log "❌ llama-server no encontrado: ${LLAMA_SERVER}"
        exit 1
    fi

    log "🚀 Iniciando llama-server (Qwen3-Coder-30B) en ${LLAMA_URL}..."
    log "   Capas GPU: ${NGL} (auto = tantas como quepan)"
    log "   Contexto: ${CTX} | Batch: ${BATCH}"

    cd "${REPO_DIR}"
    # shellcheck disable=SC2086
    nohup "${LLAMA_SERVER}" \
        -m "${MODEL}" \
        --host 127.0.0.1 \
        --port "${LLAMA_PORT}" \
        -ngl "${NGL}" \
        -c "${CTX}" \
        -b "${BATCH}" \
        -ub 128 \
        -t 10 \
        -n 2048 \
        --timeout 300 \
        --metrics \
        --perf \
        -ctk q8_0 \
        -ctv q8_0 \
        --jinja \
        > "${LOG_DIR}/llama.log" 2>&1 \
        &
    save_pid llama $!
    cd - > /dev/null

    if ! wait_for_port "${LLAMA_PORT}" "llama-server" 120; then
        log "Ver log: ${LOG_DIR}/llama.log"
        exit 1
    fi
}

start_searxng() {
    if is_port_open "${SEARXNG_PORT}"; then
        log "✅ SearXNG ya está corriendo en ${SEARXNG_URL}"
        return 0
    fi

    log "🚀 Iniciando SearXNG en ${SEARXNG_URL}..."
    (cd "${SEARXNG_DIR}" && docker compose up -d)

    if ! wait_for_port "${SEARXNG_PORT}" "SearXNG" 60; then
        log "Ver logs: (cd ${SEARXNG_DIR} && docker compose logs --tail=50 core)"
        exit 1
    fi
}

start_api() {
    local host="${1:-127.0.0.1}"

    if is_port_open "${API_PORT}"; then
        log "✅ API ya está corriendo en puerto ${API_PORT}"
        return 0
    fi

    if [ ! -d "${REPO_DIR}/.venv" ]; then
        log "❌ No existe ${REPO_DIR}/.venv. Crea el entorno virtual primero."
        exit 1
    fi

    log "🚀 Iniciando API en ${host}:${API_PORT}..."
    cd "${REPO_DIR}"
    LLAMA_URL="${LLAMA_URL}" API_HOST="${host}" API_PORT="${API_PORT}" \
        nohup "${REPO_DIR}/.venv/bin/uvicorn" server.main:app \
        --host "${host}" --port "${API_PORT}" \
        > "${LOG_DIR}/api.log" 2>&1 \
        &
    save_pid api $!
    cd - > /dev/null

    if ! wait_for_port "${API_PORT}" "API" 60; then
        log "Ver log: ${LOG_DIR}/api.log"
        exit 1
    fi
}

start_webui() {
    if is_port_open "${WEBUI_PORT}"; then
        log "✅ Open WebUI ya está corriendo en http://localhost:${WEBUI_PORT}"
        return 0
    fi

    log "🚀 Iniciando Open WebUI en http://localhost:${WEBUI_PORT}..."
    (cd "${WEBUI_DIR}" && OPEN_WEBUI_PORT="${WEBUI_PORT}" docker compose up -d)

    if ! wait_for_port "${WEBUI_PORT}" "Open WebUI" 120; then
        log "Open WebUI puede estar descargando el modelo de embeddings."
        log "Ver logs: (cd ${WEBUI_DIR} && docker compose logs --tail=50)"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Parada de servicios
# ---------------------------------------------------------------------------

stop_service() {
    local name="$1"
    local pid
    pid="$(read_pid "${name}")"

    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        log "🛑 Deteniendo ${name} (PID ${pid})..."
        kill -TERM "${pid}" 2>/dev/null || true
        for ((i = 0; i < 30; i++)); do
            if ! kill -0 "${pid}" 2>/dev/null; then
                break
            fi
            sleep 1
        done
        if kill -0 "${pid}" 2>/dev/null; then
            log "Forzando cierre de ${name}..."
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi

    remove_pid "${name}"
}

stop_all() {
    log "🛑 Deteniendo servicios..."

    if [ -d "${WEBUI_DIR}" ]; then
        (cd "${WEBUI_DIR}" && docker compose down 2>/dev/null) || true
    fi

    stop_service api

    if [ -d "${SEARXNG_DIR}" ]; then
        (cd "${SEARXNG_DIR}" && docker compose down 2>/dev/null) || true
    fi

    stop_service llama

    log "✅ Todo detenido"
}

# ---------------------------------------------------------------------------
# Estado
# ---------------------------------------------------------------------------

status() {
    echo "Estado de los servicios:"
    local item name port
    for item in "llama-server:${LLAMA_PORT}" "SearXNG:${SEARXNG_PORT}" "API:${API_PORT}" "Open WebUI:${WEBUI_PORT}"; do
        name="${item%:*}"
        port="${item#*:}"
        if is_port_open "${port}"; then
            echo "  ✅ ${name} en puerto ${port}"
        else
            echo "  ❌ ${name} detenido"
        fi
    done
}

# ---------------------------------------------------------------------------
# Recuperación de acceso a Open WebUI
# ---------------------------------------------------------------------------

webui_reset() {
    local volume_name="open-webui_open-webui-data"
    local image="ghcr.io/open-webui/open-webui:main"
    local was_running=false
    local pass1 pass2
    local reset_output admin_email admin_name

    if ! docker info >/dev/null 2>&1; then
        log "❌ Docker no está disponible."
        exit 1
    fi

    if ! docker volume inspect "${volume_name}" >/dev/null 2>&1; then
        log "❌ No existe el volumen ${volume_name}."
        log "   Arranca Open WebUI al menos una vez con ./llm web antes de restablecer la contraseña."
        exit 1
    fi

    if docker ps --format '{{.Names}}' | grep -qx "open-webui"; then
        was_running=true
    fi

    if [ "${was_running}" = true ]; then
        log "🛑 Deteniendo Open WebUI para modificar la base de datos..."
        (cd "${WEBUI_DIR}" && docker compose stop) || true
    fi

    read -rsp "Nueva contraseña de administrador: " pass1
    echo
    read -rsp "Repite la contraseña: " pass2
    echo

    if [ "${pass1}" != "${pass2}" ]; then
        log "❌ Las contraseñas no coinciden."
        if [ "${was_running}" = true ]; then
            log "🚀 Volviendo a arrancar Open WebUI..."
            (cd "${WEBUI_DIR}" && docker compose start) || true
        fi
        exit 1
    fi

    if [ -z "${pass1}" ]; then
        log "❌ La contraseña no puede estar vacía."
        if [ "${was_running}" = true ]; then
            log "🚀 Volviendo a arrancar Open WebUI..."
            (cd "${WEBUI_DIR}" && docker compose start) || true
        fi
        exit 1
    fi

    log "🔄 Restableciendo contraseña..."

    # El script va en un fichero montado. No se puede pasar con un heredoc:
    # python3 - leería el programa por stdin y la contraseña se perdería.
    mkdir -p /tmp/opencode
    reset_script="$(mktemp /tmp/opencode/webui-reset.XXXXXX.py)"
    cat > "${reset_script}" << 'PY'
import bcrypt
import sqlite3
import sys
import uuid

password = sys.stdin.readline().rstrip("\n")
if not password:
    print("ERROR: la contraseña llegó vacía al contenedor.", file=sys.stderr)
    sys.exit(1)

conn = sqlite3.connect("/data/webui.db")
conn.row_factory = sqlite3.Row
cur = conn.cursor()

cur.execute("""
    SELECT a.id, a.email, u.name, u.role
    FROM auth a
    JOIN user u ON a.id = u.id
    WHERE u.role = 'admin'
""")
admins = cur.fetchall()

if not admins:
    print("ERROR: no hay ningún usuario administrador.", file=sys.stderr)
    sys.exit(1)

if len(admins) > 1:
    print("ERROR: hay varios administradores; elige uno manualmente.", file=sys.stderr)
    for admin in admins:
        print(f"  - {admin['email']} ({admin['name']})", file=sys.stderr)
    sys.exit(1)

admin = admins[0]
password_bytes = password.encode("utf-8")
hashed = bcrypt.hashpw(password_bytes, bcrypt.gensalt(rounds=12)).decode()
if not bcrypt.checkpw(password_bytes, hashed.encode("utf-8")):
    print("ERROR: el hash generado no coincide con la contraseña.", file=sys.stderr)
    sys.exit(1)

cur.execute(
    "UPDATE auth SET password = ?, active = 1, session_stamp = ? WHERE id = ?",
    (hashed, str(uuid.uuid4()), admin["id"]),
)
conn.commit()

stored = cur.execute("SELECT password FROM auth WHERE id = ?", (admin["id"],)).fetchone()[0]
if not bcrypt.checkpw(password_bytes, stored.encode("utf-8")):
    print("ERROR: la base no guardó la contraseña.", file=sys.stderr)
    sys.exit(1)

print(f"EMAIL:{admin['email']}")
print(f"NAME:{admin['name']}")
PY

    if ! reset_output=$(printf '%s\n' "${pass1}" | docker run --rm -i --entrypoint python3 \
        -v "${volume_name}:/data" \
        -v "${reset_script}:/reset.py:ro" \
        "${image}" /reset.py); then
        rm -f "${reset_script}"
        unset pass1 pass2
        log "❌ No se pudo restablecer la contraseña."
        if [ "${was_running}" = true ]; then
            log "🚀 Volviendo a arrancar Open WebUI..."
            (cd "${WEBUI_DIR}" && docker compose start) || true
        fi
        exit 1
    fi
    rm -f "${reset_script}"
    unset pass1 pass2

    admin_email=$(echo "${reset_output}" | sed -n 's/^EMAIL://p')
    admin_name=$(echo "${reset_output}" | sed -n 's/^NAME://p')

    if [ -z "${admin_email}" ]; then
        log "❌ No se pudo restablecer la contraseña."
        if [ "${was_running}" = true ]; then
            log "🚀 Volviendo a arrancar Open WebUI..."
            (cd "${WEBUI_DIR}" && docker compose start) || true
        fi
        exit 1
    fi

    if [ "${was_running}" = true ]; then
        log "🚀 Arrancando Open WebUI..."
        (cd "${WEBUI_DIR}" && docker compose start)
    fi

    log "✅ Contraseña restablecida para ${admin_name} <${admin_email}>."
    log "   Entra en http://localhost:${WEBUI_PORT} con ese email y la contraseña nueva."
}

# ---------------------------------------------------------------------------
# Modos de uso
# ---------------------------------------------------------------------------

run_cli() {
    log "🖥️  Modo CLI interactivo."
    log "   Escribe tu pregunta, /debug para traza, /clear para borrar historial, /quit para salir."
    cd "${REPO_DIR}"
    python3 agent/agent.py
}

run_api() {
    start_llama
    start_searxng
    start_api 127.0.0.1

    log ""
    log "✅ API lista en ${API_URL}"
    log "   Logs: ${LOG_DIR}/api.log"
    log "   Presiona Ctrl+C para detener todo."
    log ""

    trap stop_all INT TERM
    wait
}

run_web() {
    start_llama
    start_searxng
    start_api 0.0.0.0
    start_webui

    log ""
    log "✅ Open WebUI listo en http://localhost:${WEBUI_PORT}"
    log "   API expuesta a Docker en 0.0.0.0:${API_PORT}"
    log "   Logs: ${LOG_DIR}/"
    log "   Presiona Ctrl+C para detener todo."
    log ""

    trap stop_all INT TERM
    wait
}

# ---------------------------------------------------------------------------
# Entrada principal
# ---------------------------------------------------------------------------

case "${1:-}" in
    cli)
        start_llama
        start_searxng
        run_cli
        ;;
    api)
        run_api
        ;;
    web)
        run_web
        ;;
    stop)
        stop_all
        ;;
    status)
        status
        ;;
    webui-reset)
        webui_reset
        ;;
    *)
        echo "Uso: $0 {cli|api|web|stop|status|webui-reset}"
        echo ""
        echo "  cli          Terminal interactiva (llama-server + SearXNG + agente)"
        echo "  api          Solo API en ${API_URL} (para OpenCode u otras apps)"
        echo "  web          Navegador con Open WebUI (todo el stack)"
        echo "  stop         Detener todos los servicios"
        echo "  status       Ver qué servicios están corriendo"
        echo "  webui-reset  Restablecer la contraseña de admin de Open WebUI"
        echo ""
        echo "Variables de entorno útiles:"
        echo "  LLAMA_PORT, SEARXNG_PORT, API_PORT, WEBUI_PORT"
        echo "  NGL, CTX, BATCH (perfil del modelo 30B)"
        exit 1
        ;;
esac
